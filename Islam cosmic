<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>เวลาละหมาด</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;500;700&family=Amiri+Quran&display=swap" rel="stylesheet">
<style>
:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  --a: #0b1030; --b: #1d2a6b; --ink: #fff;
  --soft: rgba(255,255,255,.8); --line: rgba(255,255,255,.12);
  --glow: #ffd98a; --onglow: #1a1a2e;
  --fill: rgba(255,255,255,.10); --fill2: rgba(255,255,255,.15);
  --fill3: rgba(0,0,0,.35);
  --shadow-light: rgba(255,255,255,0.15);
  --shadow-dark: rgba(0,0,0,0.25);
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
[hidden] { display: none !important; }
*, *::before, *::after { box-sizing: inherit; }
body[data-p="dawn"]{--a:#3a2a63;--b:#925a5a;--glow:#ffe0b0}
body[data-p="day"]{--a:#0e4a6e;--b:#286f8a;--glow:#fff3b0}
body[data-p="late"]{--a:#7a3a1c;--b:#895c2b;--glow:#fff0c0}
body[data-p="dusk"]{--a:#2a1b55;--b:#a64266;--glow:#ffc0a0}
body[data-p="night"]{--a:#070b22;--b:#1d2a6b;--glow:#cfd8ff}
body[data-t="dark"]{--a:#0a0a0f;--b:#181c2b;--glow:#8fd0ff; --shadow-dark: rgba(0,0,0,0.6);}
body[data-t="light"]{--a:#f2f6f8;--b:#cfe3ea;--glow:#076456;--ink:#10222b;--soft:rgba(16,34,43,.68);--line:rgba(16,34,43,.15);--onglow:#fff;--fill:rgba(255,255,255,.5);--fill2:rgba(255,255,255,.7);--fill3:rgba(16,34,43,.15); --shadow-light: rgba(255,255,255,0.8); --shadow-dark: rgba(0,0,0,0.1);}
body[data-t="green"]{--a:#0b3d2e;--b:#177657;--glow:#ffe9a8}
body[data-t="purple"]{--a:#2b1450;--b:#6f43b8;--glow:#ffd6f5}
body[data-t="gold"]{--a:#3b2a08;--b:#8b6218;--glow:#fff1c2}
body[data-t="rose"]{--a:#4a1230;--b:#ad3f65;--glow:#ffe0e8}
body[data-t="ocean"]{--a:#06304a;--b:#0f6f95;--glow:#b8f0ff}
body[data-t="orange"]{--a:#5a1f0a;--b:#a34a17;--glow:#ffe3b0}
body[data-t="red"]{--a:#4a0f1a;--b:#b02a3f;--glow:#ffd0d6}
body[data-t="teal"]{--a:#053a3d;--b:#0b7674;--glow:#d0fffb}
body[data-t="blue"]{--a:#0f1b4d;--b:#3f5fd6;--glow:#d5e0ff}
body[data-t="coffee"]{--a:#2e1c12;--b:#7a5238;--glow:#f3d9b8}
body[data-t="olive"]{--a:#1f2d0f;--b:#48731a;--glow:#eaffb8}
body[data-t="slate"]{--a:#1c2229;--b:#4b5a6a;--glow:#e0ecf7}
body[data-t="cream"]{--a:#faf3e6;--b:#ecd9b8;--glow:#854e08;--ink:#3a2a12;--soft:rgba(58,42,18,.78);--line:rgba(58,42,18,.15);--onglow:#fff;--fill:rgba(255,255,255,.5);--fill2:rgba(255,255,255,.8);--fill3:rgba(58,42,18,.15); --shadow-light: rgba(255,255,255,0.8); --shadow-dark: rgba(0,0,0,0.1);}
body[data-t="mint"]{--a:#eef8f1;--b:#c6e6d2;--glow:#136940;--ink:#10301f;--soft:rgba(16,48,31,.78);--line:rgba(16,48,31,.15);--onglow:#fff;--fill:rgba(255,255,255,.5);--fill2:rgba(255,255,255,.8);--fill3:rgba(16,48,31,.15); --shadow-light: rgba(255,255,255,0.8); --shadow-dark: rgba(0,0,0,0.1);}
body[data-t="blush"]{--a:#fdf0f4;--b:#f4c6d6;--glow:#992a4e;--ink:#3a1020;--soft:rgba(58,16,32,.78);--line:rgba(58,16,32,.15);--onglow:#fff;--fill:rgba(255,255,255,.5);--fill2:rgba(255,255,255,.8);--fill3:rgba(58,16,32,.15); --shadow-light: rgba(255,255,255,0.8); --shadow-dark: rgba(0,0,0,0.1);}
body[data-t="sky"]{--a:#eef5fd;--b:#c4dcf5;--glow:#1a58a4;--ink:#10243d;--soft:rgba(16,36,61,.78);--line:rgba(16,36,61,.15);--onglow:#fff;--fill:rgba(255,255,255,.5);--fill2:rgba(255,255,255,.8);--fill3:rgba(16,36,61,.15); --shadow-light: rgba(255,255,255,0.8); --shadow-dark: rgba(0,0,0,0.1);}

body {
  margin: 0; min-height: 100vh;
  background: #0b1030;
  background: linear-gradient(170deg, var(--a), var(--b));
  background-attachment: fixed;
  color: var(--ink);
  font-family: "IBM Plex Sans Thai", system-ui, sans-serif;
  transition: background 1s ease-in-out;
}
main { max-width: 480px; margin: 0 auto; padding: 14px 16px 48px; }
.brand { display: flex; align-items: center; gap: 8px; margin: 2px 4px 12px; font-size: 16px; font-weight: 500; color: var(--soft); text-shadow: 0 2px 4px var(--fill3); }
.brand i { font-style: normal; font-size: 22px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2)); }
.bar { display: flex; gap: 10px; align-items: center; }

/* 3D Modern Buttons */
select, button {
  font: inherit; color: var(--ink);
  background: linear-gradient(145deg, var(--fill2), var(--fill));
  border: 1px solid var(--line);
  border-top: 1px solid var(--shadow-light);
  border-radius: 999px;
  padding: 10px 16px;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 6px 16px var(--shadow-dark), inset 0 1px 2px var(--shadow-light);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}
select { flex: 1; min-width: 0; appearance: none; }
select option { color: #111; }
button:active, .qr:active, select:active {
  transform: translateY(3px) scale(0.97);
  box-shadow: 0 2px 8px var(--shadow-dark), inset 0 3px 6px var(--shadow-dark);
}
button:focus-visible, select:focus-visible { outline: 2px solid var(--glow); outline-offset: 4px; }

/* Hero 3D Card */
.hero {
  margin-top: 18px;
  padding: 24px 20px 20px;
  background: linear-gradient(135deg, var(--fill2), var(--fill));
  border: 1px solid var(--line);
  border-top: 1px solid var(--shadow-light);
  border-radius: 40px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 20px 40px var(--shadow-dark), inset 0 2px 6px var(--shadow-light);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: radial-gradient(circle, var(--shadow-light) 0%, transparent 60%);
  opacity: 0.1; pointer-events: none;
}
.hero .date { margin: 0; color: var(--soft); font-weight: 300; font-size: 15px; }
.hero .date b { font-weight: 500; color: var(--ink); }
.hero .next { margin: 24px 0 0; font-size: 14px; color: var(--soft); letter-spacing: .02em; }
.hero h1 { margin: 2px 0 0; font-size: clamp(48px, 15vw, 68px); line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; text-shadow: 0 4px 12px var(--fill3); }
.hero .cd {
  display: inline-block; margin-top: 12px; padding: 6px 20px;
  border-radius: 999px; background: var(--glow); color: var(--onglow);
  font-weight: 600; font-size: clamp(24px, 7vw, 30px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2), inset 0 -2px 4px rgba(0,0,0,0.2), inset 0 2px 4px rgba(255,255,255,0.4);
}

/* 3D Arc */
.arc { width: 100%; margin: 24px 0 4px; display: block; overflow: visible; filter: drop-shadow(0 8px 12px var(--shadow-dark)); }
.arc .base { stroke: var(--line); stroke-width: 4; }
.arc .prog { stroke: var(--glow); stroke-width: 5; filter: drop-shadow(0 0 8px var(--glow)); }
.sun { fill: var(--glow); filter: drop-shadow(0 0 16px var(--glow)); }
.arcl { display: flex; justify-content: space-between; font-size: 13px; color: var(--soft); font-variant-numeric: tabular-nums; font-weight: 500; }

/* List 3D Card */
ul#list {
  list-style: none; margin: 20px 0 0; padding: 8px 14px;
  background: var(--fill);
  border: 1px solid var(--line);
  border-bottom: 1px solid var(--shadow-light);
  border-radius: 32px;
  box-shadow: inset 0 4px 12px var(--shadow-dark), 0 4px 15px rgba(0,0,0,0.1);
}
#list li { display: flex; align-items: center; gap: 12px; padding: 16px 4px 16px 8px; border-bottom: 1px solid var(--line); position: relative; transition: all 0.3s ease; }
#list li:last-child { border-bottom: 0; }
#list li .n { font-size: 18px; font-weight: 500; }
#list li .ar { font-size: 15px; color: var(--soft); font-weight: 300; }
#list li .t { margin-left: auto; font-size: 22px; font-variant-numeric: tabular-nums; font-weight: 600; text-shadow: 0 2px 4px var(--fill3); }
#list .rk { margin-left: auto; font-size: 13px; color: var(--soft); font-weight: 300; }
#list .rk~.t { margin-left: 14px; }
li.sr { opacity: 0.7; } li.sr .n { font-weight: 400; }
li.cur::before {
  content: ""; position: absolute; left: -2px; top: 50%; width: 8px; height: 8px; margin-top: -4px;
  border-radius: 50%; background: var(--glow); box-shadow: 0 0 12px var(--glow), inset 0 1px 2px rgba(255,255,255,0.8);
}
#list li.nx {
  background: linear-gradient(135deg, var(--fill2), var(--fill));
  border-radius: 24px;
  margin: 6px -8px;
  padding: 16px 12px;
  border: 1px solid var(--line);
  border-top: 1px solid var(--shadow-light);
  box-shadow: 0 8px 24px var(--shadow-dark), inset 0 1px 2px var(--shadow-light);
}
li .tag { font-size: 12px; background: var(--glow); color: var(--onglow); border-radius: 99px; padding: 2px 10px; font-weight: 600; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }

/* Custom Checkbox */
.ck {
  width: 28px; height: 28px; padding: 0; flex: none; align-self: center;
  border-radius: 50%; background: var(--fill);
  border: 1px solid var(--line);
  border-top: 1px solid var(--shadow-light);
  box-shadow: inset 0 2px 4px var(--shadow-dark), 0 2px 4px rgba(255,255,255,0.05);
  position: relative; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}
.ck[aria-pressed=true] { background: var(--glow); border-color: var(--glow); box-shadow: 0 4px 12px var(--glow), inset 0 -2px 4px rgba(0,0,0,0.2); transform: scale(1.05); }
.ck[aria-pressed=true]::after { content: "✓"; position: absolute; inset: 0; color: var(--onglow); font-size: 16px; line-height: 26px; text-align: center; font-weight: bold; }
.ck0 { width: 28px; flex: none; }

/* Grid 3D Buttons */
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
.grid .qr {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  padding: 18px 6px; margin: 0; min-height: 100px;
  border-radius: 28px; font-size: 13.5px; line-height: 1.3; text-align: center;
  background: linear-gradient(145deg, var(--fill2), var(--fill));
  border: 1px solid var(--line); border-top: 1px solid var(--shadow-light); border-left: 1px solid var(--shadow-light);
  box-shadow: 0 10px 25px var(--shadow-dark), inset 0 2px 4px rgba(255,255,255,0.05);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  font-weight: 500;
}
.grid .qr .ic { font-size: 30px; line-height: 1; filter: drop-shadow(0 6px 8px rgba(0,0,0,0.3)); transition: transform 0.2s; }
.grid .qr:hover .ic { transform: scale(1.1); }

/* Zikr Big Tactile Button (Human Touch) */
.tap {
  --p: 0; display: block; width: min(76vw, 300px); aspect-ratio: 1;
  border-radius: 50%; border: 0; padding: 16px; margin: 30px auto 10px; cursor: pointer; touch-action: manipulation;
  -webkit-tap-highlight-color: transparent; color: var(--ink);
  background: conic-gradient(var(--glow) calc(var(--p)*1%), var(--fill3) 0);
  box-shadow: 0 20px 50px rgba(0,0,0,0.4), inset 0 4px 10px var(--shadow-light);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.tap .in {
  width: 100%; height: 100%; border-radius: 50%;
  background: linear-gradient(135deg, var(--a), var(--b));
  box-shadow: inset 0 10px 20px var(--shadow-dark), 0 8px 16px rgba(0,0,0,0.3), inset 0 2px 4px var(--shadow-light);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
}
.tap:active .in { transform: scale(0.93); box-shadow: inset 0 20px 40px rgba(0,0,0,0.7); }
.zx { font-family: "Amiri Quran", "Noto Naskh Arabic", serif; font-size: clamp(30px, 9vw, 40px); line-height: 1.6; text-shadow: 0 4px 8px rgba(0,0,0,0.5); }
.zn { font-size: clamp(56px, 18vw, 76px); font-weight: 300; font-variant-numeric: tabular-nums; line-height: 1; text-shadow: 0 4px 10px rgba(0,0,0,0.3); }
.zg { font-size: 15px; color: var(--soft); font-weight: 500; }

/* Misc Classes */
.num{width:2.4ch;color:var(--soft);font-variant-numeric:tabular-nums}
#ql{margin-top:6px} #list .tag,#list .rk{white-space:nowrap}
@media(max-width:440px){#list .ar{display:none}}
.sd1 { margin-top: 12px; }
</style>
</head>
<body data-p="day" data-t="light">
  <main>
    <div class="brand"><i>🕌</i> เวลาละหมาด</div>
    <div class="bar">
      <select aria-label="เลือกสถานที่">
        <option value="bkk">กรุงเทพมหานคร</option>
        <option value="narathiwat" selected>นราธิวาส</option>
      </select>
      <button>ตั้งค่า</button>
    </div>

    <div class="hero">
      <p class="date">วันพฤหัสบดีที่ <b>1 ตุลาคม 2026</b></p>
      <p class="next">ละหมาดถัดไป (ซุฮ์ริ)</p>
      <h1>12:15</h1>
      <div class="cd">02:34:40</div>
    </div>

    <ul id="list">
      <li class="sr">
        <div class="n">ซุบฮิ</div>
        <div class="t">04:50</div>
      </li>
      <li>
        <div class="n">ชูรูก (ตะวันขึ้น)</div>
        <div class="t">06:05</div>
      </li>
      <li class="nx cur">
        <div class="n">ซุฮ์ริ</div>
        <div class="t">12:15</div>
      </li>
      <li>
        <div class="n">อัสริ</div>
        <div class="t">15:25</div>
      </li>
      <li>
        <div class="n">มัฆริบ</div>
        <div class="t">18:10</div>
      </li>
      <li>
        <div class="n">อิชาอ์</div>
        <div class="t">19:20</div>
      </li>
    </ul>

    <button class="tap" aria-label="Tasbih">
      <div class="in">
        <div class="zx">سُبْحَانَ ٱللَّٰهِ</div>
        <div class="zn">0</div>
        <div class="zg">ซุบฮานัลลอฮ์</div>
      </div>
    </button>
  </main>

  <script>
    // สคริปต์สำหรับนับจำนวนเวลาคลิกปุ่ม Zikr
    document.addEventListener("DOMContentLoaded", () => {
      const tapButton = document.querySelector('.tap');
      const countDisplay = document.querySelector('.zn');
      let count = 0;

      tapButton.addEventListener('click', () => {
        count++;
        countDisplay.textContent = count;
        // เอฟเฟกต์แสงรอบปุ่ม (เป็น Option เสริม)
        tapButton.style.setProperty('--p', Math.min((count % 33) * 3, 100)); 
      });
    });
  </script>
</body>
</html>
